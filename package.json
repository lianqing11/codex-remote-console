{
  "name": "coding-agent-console",
  "version": "0.1.0",
  "description": "Self-hosted browser console for Codex, Cursor Agent, and Claude Code sessions on a remote machine.",
  "license": "MIT",
  "keywords": [
    "codex",
    "codex-cli",
    "cursor-agent",
    "remote-development",
    "webui",
    "ai-coding",
    "self-hosted",
    "nextjs",
    "websocket"
  ],
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:proxy": "NEXT_PUBLIC_BASE_PATH=/codex_web_cursor PORT=3032 tsx server/index.ts",
    "build": "next build",
    "build:proxy": "NEXT_PUBLIC_BASE_PATH=/codex_web_cursor next build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "prestart:proxy": "npm run build:proxy",
    "start:proxy": "NODE_ENV=production NEXT_PUBLIC_BASE_PATH=/codex_web_cursor PORT=3032 tsx server/index.ts",
    "test:slash": "tsx scripts/slashCommands.test.ts",
    "test:diff": "tsx scripts/gitDiff.test.ts",
    "test:project": "tsx scripts/projectFiles.test.ts",
    "test:project-ui": "tsx scripts/projectFileUtils.test.ts",
    "test:uploads": "tsx scripts/uploads.test.ts",
    "test:gateway": "tsx scripts/stdioSupport.test.ts",
    "test:runtime": "tsx scripts/sessionRuntime.test.ts",
    "test:session-execution": "tsx scripts/sessionExecution.test.ts",
    "test:thread-runtime": "tsx scripts/threadRuntimeMetadata.test.ts",
    "test:codex-usage": "tsx scripts/codexUsage.test.ts",
    "test:cursor-usage": "tsx scripts/cursorUsage.test.ts",
    "test:agent-queue": "NODE_NO_WARNINGS=1 tsx scripts/agentQueue.test.ts",
    "test:queue-ui": "tsx scripts/queueModel.test.ts",
    "test:fleet": "tsx scripts/fleetModel.test.ts",
    "test:thread-model": "tsx scripts/threadModel.test.ts",
    "test:plan-worklog": "tsx scripts/planWorklog.test.ts",
    "test:thread-view-store": "tsx scripts/threadViewStore.test.ts",
    "test:thread-notifications": "tsx scripts/threadNotifications.test.ts",
    "test:server-env": "tsx scripts/serverEnv.test.ts",
    "test:feishu": "tsx scripts/feishuNotify.test.ts",
    "test:cursor-feishu": "tsx scripts/cursorFeishuNotify.test.ts",
    "test:warm-pool": "tsx scripts/warmThreadPool.test.ts",
    "test:provider-ui": "tsx scripts/providerUI.test.ts",
    "test:provider-protocol": "tsx scripts/providerProtocol.test.ts",
    "test:auth-isolation": "tsx scripts/authIsolation.test.ts",
    "test:session-title": "tsx scripts/sessionTitle.test.ts",
    "test:cursor": "tsx scripts/cursorProvider.test.ts",
    "test:claude": "tsx scripts/claudeProvider.test.ts",
    "test:file-context": "tsx scripts/fileContext.test.ts",
    "test:approval": "tsx scripts/approvalPolicy.test.ts",
    "test:service-smoke": "tsx scripts/serviceSmoke.ts",
    "test:service-project-upload": "tsx scripts/projectUploadServiceSmoke.ts",
    "test:playwright-smoke": "python scripts/playwrightSmoke.py",
    "test:playwright-upload": "python scripts/playwrightFileUpload.py",
    "test:playwright-project-upload": "python scripts/playwrightProjectUpload.py",
    "test:playwright-codex-usage": "python scripts/playwrightCodexUsage.py",
    "test:playwright-cursor-usage": "python scripts/playwrightCursorUsage.py",
    "test:playwright-queue": "python scripts/playwrightQueuePersistence.py",
    "test:playwright-queue-paused": "python scripts/playwrightQueuePausedUI.py",
    "test:playwright-plan-confirm": "python scripts/playwrightPlanConfirm.py",
    "test:playwright-session-close": "python scripts/playwrightSessionClose.py",
    "test:playwright-session-runtime": "python scripts/playwrightSessionRuntime.py",
    "test:playwright-responsive": "python scripts/playwrightResponsiveUI.py",
    "test:playwright-mobile-overflow": "python scripts/playwrightMobileOverflow.py",
    "test:playwright-mobile-plan-mode": "python scripts/playwrightMobilePlanMode.py",
    "test:playwright-plan-worklog": "python scripts/playwrightPlanWorklogCollapse.py",
    "test:playwright-provider": "python scripts/playwrightProviderRun.py",
    "test:playwright-cursor-agent": "python scripts/playwrightCursorAgent.py",
    "test:playwright-single-message": "python scripts/playwrightSingleMessage.py",
    "test:cleanup-smoke": "tsx scripts/cleanupSmokeSessions.ts",
    "test:all": "npm run test:slash && npm run test:diff && npm run test:project && npm run test:project-ui && npm run test:uploads && npm run test:gateway && npm run test:runtime && npm run test:session-execution && npm run test:thread-runtime && npm run test:codex-usage && npm run test:cursor-usage && npm run test:agent-queue && npm run test:queue-ui && npm run test:fleet && npm run test:thread-model && npm run test:plan-worklog && npm run test:thread-view-store && npm run test:server-env && npm run test:feishu && npm run test:cursor-feishu && npm run test:warm-pool && npm run test:provider-ui && npm run test:provider-protocol && npm run test:auth-isolation && npm run test:session-title && npm run test:cursor && npm run test:claude && npm run test:file-context && npm run test:approval && npm run test:thread-notifications",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "check:proxy": "npm run typecheck && npm run build:proxy",
    "generate:codex-protocol": "codex app-server generate-ts --out src/generated/codex-protocol --experimental"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "next": "^15.5.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
