# Example environment for Coding Agent Console.
# Export these variables in your shell or process manager before starting the server.

PORT=3032
HOST=0.0.0.0

# Set one of these for private deployments. Production requires one of them.
# CODEX_WEB_PASSWORD=replace-with-strong-password
# CODEX_WEB_TOKEN=replace-with-random-token

# Use a separate random cookie-signing secret for production.
# CODEX_WEB_SECRET=replace-with-random-secret

# Set when serving behind a subpath reverse proxy, for example /codex_web_cursor.
# NEXT_PUBLIC_BASE_PATH=/codex_web_cursor

# Optional project roots. When set, resolve/list/read APIs only accept paths inside these roots.
# Separate entries with ":" on Unix and ";" on Windows.
# CODEX_WEB_PROJECT_ROOTS=/absolute/path/to/projects

# Set when the console is served over HTTPS so the session cookie gets the Secure flag.
# CODEX_WEB_COOKIE_SECURE=on

# Upstream Clash/VPN used only for Codex/Cursor/Claude official APIs (OpenAI / Cursor / Anthropic).
# Spawned processes get a local allowlist proxy; downloads go direct unless you export Clash yourself.
# CODEX_WEB_PROXY_URL=http://127.0.0.1:7893

# Optional location for Coding Agent Console-owned Cursor/Claude metadata and transcripts.
# Defaults to ~/.local/share/coding-agent-console.
# CODING_AGENT_CONSOLE_STATE_DIR=/absolute/private/path

# Maximum size of one browser-uploaded file. Defaults to 52428800 (50 MiB), capped at 100 MiB.
# Uploaded files are stored privately under CODING_AGENT_CONSOLE_STATE_DIR/uploads.
# CODEX_WEB_UPLOAD_MAX_BYTES=52428800

# Cursor Agent mode runs with --sandbox disabled --trust and without --force.
# It inherits the Node service user's filesystem access and may reach paths outside the selected workspace.

# Optional behavior switches.
# CODEX_WEB_GATEWAY=stdio
# CODEX_WEB_AUTO_APPROVE=on
# CODEX_WEB_AUTO_APPROVE_READONLY=on
# CODEX_WEB_AUTO_APPROVE_MCP=on
# CODEX_WEB_APPROVAL_LOG=on

# Optional Codex, Cursor Agent, and Claude Code turn-completion notifications via lark-cli (bot identity).
# Codex Plan input requests are also posted so the configured user knows a choice is waiting.
# Creates one private Feishu group per provider session; Plan choices remain in the web Console.
# CODEX_WEB_FEISHU_NOTIFY=on
# Required when notifications are enabled. Keep the real recipient ID in .env.local.
# CODEX_WEB_FEISHU_USER_OPEN_ID=ou_xxx
# CODEX_WEB_FEISHU_CLI=lark-cli
# CODEX_WEB_FEISHU_STATE_PATH=/absolute/path/to/feishu-chats.json
# Long summaries are sent in multiple messages without dropping content.
# This byte limit applies to each summary chunk; the legacy SUMMARY_MAX name is still accepted.
# CODEX_WEB_FEISHU_CHUNK_MAX_BYTES=10000
